# Saved planning blueprint — kept local, not tracked
PLAN.md

# Virtual environment — rebuildable from pyproject.toml, never committed
.venv/

# Personal data — your docs, the vector DB, traces, drafts, memory
knowledge_base/
data/

# Python caches
__pycache__/
*.pyc

# Editable-install build metadata (regenerated by `pip install -e .`)
*.egg-info/

# config.toml is the user-editable config file. We want to ignore it so that users can have their own local settings without affecting others.
config.toml

# agent_session_id is just the current session ID for the agent. It can be regenerated and doesn't need to be tracked.
agent_session_id.txt